# Copy to .env and edit if your setup differs from the defaults.
# Every value below is OPTIONAL -- the defaults assume a local Ollama install.
#
# This project needs no API keys and makes no paid calls. Embeddings and
# generation both run locally through Ollama, which is why there is nothing
# secret to configure here.

# Where Ollama is listening. Point this at another host to run the models
# somewhere other than this machine.
OLLAMA_HOST=http://localhost:11434

# Embedding model. Must be pulled first: `ollama pull nomic-embed-text`
TENANCY_RAG_EMBED_MODEL=nomic-embed-text

# Generation model. Must be pulled first: `ollama pull qwen3:8b`
TENANCY_RAG_GEN_MODEL=qwen3:8b
